table.table.table-hover
  thead.thead-default
    tr.text-center
      th style="width: 10%" = DailyWorkSummary.human_attribute_name(:date)
      th style="width: 5%" = DailyWorkSummary.human_attribute_name(:wday)
      th style="width: 5%" = DailyWorkSummary.human_attribute_name(:is_work_scheduled)
      th style="width: 10%" = DailyWorkSummary.human_attribute_name(:attendance_status)
      th style="width: 10%" = DailyWorkSummary.human_attribute_name(:started_at)
      th style="width: 10%" = DailyWorkSummary.human_attribute_name(:finished_at)
      th style="width: 10%" = DailyWorkSummary.human_attribute_name(:break_started_at)
      th style="width: 10%" = DailyWorkSummary.human_attribute_name(:break_finished_at)
      th style="width: 20%" = DailyWorkSummary.human_attribute_name(:create_edit_request)

  tbody
    - daily_work_summary.each do |summary|
      tr.align-middle.text-center
        td= summary.date
        - if summary.date.sunday? || summary.date.saturday?
          td.text-danger= l summary.date,format: "%a"
        - else
          td= l summary.date,format: "%a"
        td= summary.is_work_scheduled
        td= I18n.t("enums.attendance.status.#{summary.attendance_status}")
        td= summary.started_at.present? ? (l summary.started_at,format: :short_time) : ''
        td= summary.finished_at.present? ? (l summary.finished_at,format: :short_time) : ''
        td= summary.break_started_at.present? ? (l summary.break_started_at,format: :short_time) : ''
        td= summary.break_finished_at.present? ? (l summary.break_finished_at,format: :short_time) : ''
        - if summary.edit_request_present?
          td= link_to '申請時刻を修正',edit_employee_attendance_attendance_edit_request_path(@employee,summary.date),class: 'btn btn-secondary mr-3'
        - else
          td= link_to '時刻修正申請',new_employee_attendance_attendance_edit_request_path(@employee,summary.date),class: 'btn btn-primary mr-3'
